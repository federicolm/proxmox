## Esempio di configurazione di fail2ban
[sshd]
enabled = true
port    = ssh
# Forza l'uso del filtro sshd ma con backend systemd
filter  = sshd
backend = systemd
# Questa riga è fondamentale: dice a fail2ban cosa cercare nel journal
journalmatch = _SYSTEMD_UNIT=ssh.service
maxretry = 5
findtime = 1d
bantime  = -1

[proxmox]
enabled = true
port    = 8006
filter  = proxmox
logpath = /var/log/pveproxy/access.log
maxretry = 5
findtime = 1d
bantime  = -1
